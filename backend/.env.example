# Copy to backend/.env and fill in. Never commit .env.
# LLM_PROVIDER: mock (default) | anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Optional: point at a proxy / compatible endpoint
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=25

